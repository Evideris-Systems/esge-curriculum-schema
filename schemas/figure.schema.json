{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.evideris.com/schemas/figure.schema.json",
  "title": "Figure (source-canonical)",
  "description": "A figure from an ESGE Position Statement. Stored as caption + source URL only; images are hotlinked from the publisher's CDN (Thieme Connect for Endoscopy papers) rather than rehosted, so we don't need to worry about redistribution rights. Full-res URL for the modal / zoom target; thumbnail URL for the inline card.",
  "type": "object",
  "required": [
    "$id",
    "lineageId",
    "type",
    "version",
    "release",
    "language",
    "withinCurriculum",
    "number",
    "caption",
    "asset",
    "sourceUrls",
    "_meta"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "$id": {
      "$ref": "_common.schema.json#/$defs/versionedUrl"
    },
    "lineageId": {
      "$ref": "_common.schema.json#/$defs/lineageId"
    },
    "type": {
      "const": "figure"
    },
    "version": {
      "$ref": "_common.schema.json#/$defs/semverString"
    },
    "release": {
      "$ref": "_common.schema.json#/$defs/calverRelease"
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "_common.schema.json#/$defs/versionedUrl"
        }
      ]
    },
    "supersededBy": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "_common.schema.json#/$defs/versionedUrl"
        }
      ]
    },
    "language": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "withinCurriculum": {
      "$ref": "_common.schema.json#/$defs/lineageId"
    },
    "number": {
      "type": "integer",
      "minimum": 1,
      "description": "Figure N (as printed)."
    },
    "caption": {
      "$ref": "_common.schema.json#/$defs/localeKeyedString"
    },
    "panels": {
      "type": "array",
      "description": "Optional per-panel labels + short descriptions (e.g. Fig 2a, 2b, 2c). Panel captions are usually embedded in the main figure caption; this array is for future per-panel cross-reference.",
      "items": {
        "type": "object",
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "type": "string",
            "pattern": "^[a-z][0-9]+(?:[,\\-][0-9]+)*$|^[a-z]$|^[0-9]+$|^[ivx]+$"
          },
          "description": {
            "$ref": "_common.schema.json#/$defs/localeKeyedString"
          }
        },
        "additionalProperties": false
      }
    },
    "asset": {
      "type": "object",
      "description": "Repository-contained image extracted from the authoritative publication PDF and bound by SHA-256.",
      "required": [
        "path",
        "mediaType",
        "sha256",
        "width",
        "height"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^esge/figure/[A-Za-z0-9._/-]+\\.(png|jpg|jpeg|gif|webp)$"
        },
        "mediaType": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/gif",
            "image/webp"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "sourceUrls": {
      "type": "object",
      "description": "Original publisher-hosted image URLs retained for source provenance and comparison; readers use the verified local asset.",
      "required": [
        "fullRes"
      ],
      "properties": {
        "fullRes": {
          "type": "string",
          "format": "uri"
        },
        "thumbnail": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "_meta": {
      "$ref": "_common.schema.json#/$defs/metaBlock"
    }
  },
  "additionalProperties": false,
  "$comment": "Figures live at esge/figure/<curriculum-slug>/fig-<N>.v1.0.0.json. Their image assets retain the publication rights recorded by the source owner and are not covered by the repository's software/schema licence."
}
